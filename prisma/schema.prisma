generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(uuid())
  name          String?
  username      String?    @unique
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  phone         String?    @unique
  passwordHash  String?
  role          User_role  @default(CUSTOMER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  outletId      String?
  Account       Account[]
  orders        Order[]    @relation("CustomerOrders")
  OrderLog      OrderLog[]
  Session       Session[]
  Outlet        Outlet?    @relation(fields: [outletId], references: [id])

  @@index([outletId])
}

model Service {
  id         String           @id @default(uuid())
  outletId   String
  name       String
  category   Service_category
  price      Decimal
  unit       String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  orderItems OrderItem[]
  Outlet     Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
}

model Order {
  id              String              @id @default(uuid())
  orderNumber     String              @unique
  customerId      String
  outletId        String
  status          Order_status        @default(PENDING)
  pickupDate      DateTime?
  pickupTimeSlot  String?
  deliveryDate    DateTime?
  deliveryAddress String?             @db.Text
  totalAmount     Decimal             @default(0.000000000000000000000000000000)
  paymentStatus   Order_paymentStatus @default(UNPAID)
  paymentMethod   String              @default("CASH")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  customer        User                @relation("CustomerOrders", fields: [customerId], references: [id])
  Outlet          Outlet              @relation(fields: [outletId], references: [id])
  items           OrderItem[]
  OrderLog        OrderLog[]

  @@index([customerId])
  @@index([outletId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  serviceId String
  itemName  String
  quantity  Float
  unitPrice Decimal
  subtotal  Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@index([serviceId])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OrderLog {
  id              String                   @id
  orderId         String
  updatedByUserId String
  previousStatus  OrderLog_previousStatus?
  newStatus       OrderLog_newStatus
  timestamp       DateTime                 @default(now())
  notes           String?                  @db.Text
  Order           Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  User            User                     @relation(fields: [updatedByUserId], references: [id])

  @@index([orderId])
  @@index([updatedByUserId])
}

model Outlet {
  id        String    @id
  name      String
  address   String    @db.Text
  latitude  Float?
  longitude Float?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Order     Order[]
  Service   Service[]
  User      User[]
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Service_category {
  KILOAN
  SATUAN
  DRY_CLEAN
}

enum OrderLog_previousStatus {
  PENDING
  PICKUP_SCHEDULED
  WASHING
  IRONING
  READY_TO_DELIVER
  COMPLETED
  CANCELLED
}

enum OrderLog_newStatus {
  PENDING
  PICKUP_SCHEDULED
  WASHING
  IRONING
  READY_TO_DELIVER
  COMPLETED
  CANCELLED
}

enum Order_status {
  PENDING
  PICKUP_SCHEDULED
  WASHING
  IRONING
  READY_TO_DELIVER
  COMPLETED
  CANCELLED
}

enum User_role {
  CUSTOMER
  STAFF
  OWNER
}

enum Order_paymentStatus {
  UNPAID
  PAID
  REFUNDED
}
