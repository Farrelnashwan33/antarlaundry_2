// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  COURIER
  STAFF
}

enum OrderStatus {
  PENDING
  PICKUP
  PROCESSING
  WASHING
  DRYING
  IRONING
  READY
  DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  ASSIGNED
  PICKUP
  ON_PROCESS
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  role          Role      @default(CUSTOMER)
  
  // Relations
  customerProfile CustomerProfile?
  courierProfile  CourierProfile?
  
  orders        Order[]   @relation("CustomerOrders")
  deliveries    Delivery[] @relation("CourierDeliveries")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  addresses Address[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourierProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  vehicleType String?
  plateNumber String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Address {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  
  label             String          // e.g. "Rumah", "Kantor"
  fullAddress       String
  city              String
  postalCode        String?
  latitude          Float?
  longitude         Float?
  
  pickupOrders      Order[]         @relation("PickupAddress")
  deliveryOrders    Order[]         @relation("DeliveryAddress")
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  pricePerKg  Decimal  
  minWeight   Float?
  minPrice    Decimal?
  estimatedDays Int    @default(3)
  isActive    Boolean  @default(true)
  
  orderItems  OrderItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  
  customerId        String
  customer          User        @relation("CustomerOrders", fields: [customerId], references: [id])
  
  pickupAddressId   String
  pickupAddress     Address     @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  
  deliveryAddressId String
  deliveryAddress   Address     @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])
  
  weight            Float?
  subtotal          Decimal?    
  deliveryFee       Decimal?    
  discount          Decimal?    @default(0) 
  total             Decimal?    
  
  paymentStatus     PaymentStatus @default(UNPAID)
  orderStatus       OrderStatus   @default(PENDING)
  
  pickupDate        DateTime
  deliveryDate      DateTime?
  notes             String?     
  
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  deliveries        Delivery[]
  payment           Payment?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  
  weight    Float
  price     Decimal  
  subtotal  Decimal  
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  status    OrderStatus
  notes     String?
  
  createdAt DateTime    @default(now())
}

model Delivery {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  courierId   String?
  courier     User?          @relation("CourierDeliveries", fields: [courierId], references: [id])
  
  type        DeliveryType   // PICKUP or RETURN
  status      DeliveryStatus @default(ASSIGNED)
  
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

enum DeliveryType {
  PICKUP
  RETURN
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  amount        Decimal       
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?
  
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

model Promo {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discountPct Float?
  discountAmt Decimal? 
  isActive    Boolean  @default(true)
  validUntil  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int
  comment   String?  
  
  createdAt DateTime @default(now())
}

model JobApplication {
  id              String   @id @default(uuid())
  position        String   // "RIDER" or "CS"
  fullName        String
  email           String
  phone           String
  dob             DateTime?
  gender          String?
  address         String?
  educationDegree String?
  educationSchool String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
